<%- include('../partials/header') %>

<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet" href="/styles_typed_colors.css">

<% var isEdit = (mode === 'edit'); var P = post || {}; %>

<form action="<%= action %>" method="POST" enctype="multipart/form-data"
      class="content-form" data-media="image">

  <!-- keep the type on submit -->
  <input type="hidden" name="display_mode" value="image">
  <input type="hidden" name="media_type"   value="image">

  <h2><%= isEdit ? 'Edit image post' : 'New image post' %></h2>
  
  <h1>Image upload</h1>
  
  Image:
  <input type="file" name="media_file" accept="image/*" value="<%= P.media_file ? P.media_file : '' %>"><br>

  <label for="title">Title:</label><input type="text" name="title" value="<%= P.title ? P.title : '' %>"><br>
  
  <label for="Description">Description:</label><textarea name="content"><%= P.content ? P.content : '' %></textarea><br>
  
  <label for="Price">Price:</label><input type="number" name="price" step="0.01" value="0"><br><br>

  <button type="submit"><%= submitLabel %></button>

  <a id="cancelLink" href="/posts" class="btn btn-ghost">Cancel</a>

</form>

<style>

body{
  background-color: #000;
  color: #f0f0f0;
}

.content-form[data-media="image"] {
  background-color: hsl(60, 50%, 10%);
  border-top: 4px solid hsl(60, 90%, 50%);
  padding: 1rem;
  border-radius: 12px;
  box-shadow: 0 0 8px rgba(255, 255, 0, 0.1);
  margin: 1rem 0;
}

.content-form[data-media="image"] label {
  display: block;
  margin: 0.5rem 0 0.2rem;
  color: #eee;
  font-weight: bold;
}

.content-form[data-media="image"] input,
.content-form[data-media="image"] textarea {
  width: 100%;
  background-color: #222;
  border: 1px solid #555;
  color: #fff;
  padding: 0.5rem;
  border-radius: 8px;
  margin-bottom: 0.5rem;
}

.content-form[data-media="image"] button,a.btn {
  background-color: hsl(60, 90%, 25%);
  color: #f0f0f0;
  font-weight: bold;
  padding: 0.5rem 1rem;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: background-color 0.2s ease;
  text-decoration: none;
}

.content-form[data-media="image"] button:hover,a.btn:hover {
  background-color: hsl(60, 90%, 35%);
  text-decoration: none;
}

.content-form[data-media] input,
.content-form[data-media] textarea {
  width: 100%;
  background-color: #222;
  border: 1px solid #555;
  color: #fff;
  padding: 0.5rem;
  border-radius: 8px;
  margin-bottom: 0.5rem;
}

.content-form[data-media] label {
  display: block;
  margin: 0.5rem 0 0.2rem;
  color: #eee;
  font-weight: bold;
}

.content-form[data-media] button {
  font-weight: bold;
  padding: 0.5rem 1rem;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: background-color 0.2s ease;
}

  form {
    width: 50%;
    margin: 1rem auto;
    margin: 1rem auto;  
    padding: 1rem;
    border-radius: 12px;
    }
</style>
