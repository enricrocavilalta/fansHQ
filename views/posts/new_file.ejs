<%- include('../partials/header') %>

<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet" href="/styles_typed_colors.css">

<% 
  const P = (typeof post !== 'undefined' && post) ? post : {};
  const isEdit = !!P.id; 
%>

<div class="center-form">
  <form action="<%= isEdit ? '/posts/' + P.id + '?_method=PUT' : '/posts' %>"
      method="POST"
      enctype="multipart/form-data" data-media="file" class="content-form">

    <input type="hidden" name="media_type" value="file">

    <h1><%= isEdit ? 'Edit file' : 'File upload' %></h1>
    

    <label>File*:</label>

    <% if (P.media_url) { %>
      <p>Current file: <a href="<%= P.media_url %>" target="_blank"><%= P.media_url %></a></p>
    <% } %>

    <!-- keep the old file path in a hidden input -->
    <input type="hidden" name="media_url" value="<%= P.media_url || '' %>">

    <!-- this is the ONLY file input Multer cares about -->
    <input
      type="file"
      name="media_file"
      <%= isEdit ? '' : 'required' %>
      accept="*/*"
    />
    <br><br>


    <!--
    <label>Thumbnail:</label><br>

    <% if (P.thumbnail_url) { %>
      <p>Current thumbnail: <img src="<%= P.thumbnail_url %>" style="max-width:150px"></p>
    <% } %>

    <input
      type="file"
      name="thumbnail"
      accept="image/*"
    />
    <br><br>
    -->

    title:<br>
    <input type="text" name="title" value="<%= P.title ? P.title : '' %>"><br><br>
    
    <label>Content:<br>
      <textarea name="content" rows="6"><%= P.content ? P.content : '' %></textarea>
    </label><br><br>

    <button type="submit"><%= isEdit ? 'Update' : 'Create' %></button>

    <button type="button" class="btn" onclick="window.history.back()">CANCEL</button>
    
  </form>

</div>

<style>

  .center-form {
    display: flex;
    justify-content: center;   /* centers horizontally */
    align-items: center;       /* centers vertically */
    /*height: 100vh;*/
  }

  .content-form[data-media="file"] {
    background-color: hsl(300, 50%, 10%);
    border-top: 1px solid hsl(300, 100%, 52%);
    padding: 1rem;
    border-radius: 12px;
    box-shadow: 0 0 8px hsl(300, 50%, 10%);
    margin: 1rem 0;
  }

  .content-form[data-media="file"] h1 {
    color: #f0f0f0;
  }

  .content-form[data-media="file"] label {
    display: block;
    margin: 0.5rem 0 0.2rem;
    color: #eee;
    font-weight: bold;
  }

  .content-form[data-media="file"] input,
  .content-form[data-media="file"] textarea {
    width: 100%;
    background-color: #222;
    border: 1px solid #555;
    color: #f0f0f0;
    padding: 0.5rem;
    border-radius: 8px;
    margin-bottom: 0.5rem;
  }

  .content-form[data-media="file"] button, a.btn {
    background-color: hsl(300, 100%, 20%) !important;
    color: #000;
    font-weight: bold;
    padding: 0.5rem 1rem;
    border: 1px solid hsl(300,100%,52%) !important;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s ease;
    text-decoration: none;
  }

  .content-form[data-media="file"] button:hover, a.btn:hover {
    background-color: hsl(300, 100%, 70%);
    text-decoration: none;
  }

  .content-form[data-media] input,
  .content-form[data-media] textarea {
    width: 100%;
    background-color: #222;
    border: 1px solid #555;
    color: #fff;
    padding: 0.5rem;
    border-radius: 8px;
    margin-bottom: 0.5rem;
  }

  .content-form[data-media] label {
    display: block;
    margin: 0.5rem 0 0.2rem;
    color: #eee;
    font-weight: bold;
  }

  .content-form[data-media="file"] button {
    background-color: hsl(300, 100%, 50%);
    color: #f0f0f0;
    font-weight: bold;
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .content-form[data-media="text"] button:hover {
    background-color: hsl(300, 90%, 30%);
  }

  form {
    width: 50%;
    margin: 1rem auto;
    margin: 1rem auto;  
    padding: 1rem;
    border-radius: 12px;
    }

</style>