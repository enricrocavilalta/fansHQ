<%- include('../partials/header') %>

<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet" href="/styles_typed_colors.css">

<%
  const P = (typeof post !== 'undefined' && post) ? post : {};
  const isEdit = !!P.id;
%>

<div class="center-form">
  <form action="<%= action %>" method="POST" enctype="multipart/form-data" class="content-form" data-media="ama">
    
    <input type="hidden" name="media_type" value="ama">
    
    <h1><%= isEdit ? 'Edit AMA post' : 'AMA upload' %></h1>

    <label>Title:</label><br>
    <input type="text" name="title" value="<%= P.title ?? '' %>"><br><br>

    <label>Prompt*:</label><br>
    <textarea name="content" required><%= P.content ?? '' %></textarea><br><br>

    <button type="submit">
      <%= isEdit ? 'UPDATE POST' : 'CREATE POST' %>
    </button>

    <button type="button" class="btn" onclick="window.history.back()">CANCEL</button>
  </form>
</div>

<style>

  .center-form {
    display: flex;
    justify-content: center;   /* centers horizontally */
    align-items: center;       /* centers vertically */
    /*height: 100vh;*/
  }

  form {
    width: 50%;
    margin: 1rem auto;
    margin: 1rem auto;  
    padding: 1rem;
    border-radius: 12px;
  }

  .post-card[data-media="ama"] {
    border-top: 1px solid hsl(0, 0%, 90%);
    background-color: hsl(0, 0%, 10%);
  }

  .content-form[data-media="ama"] {
    background-color: hsl(0, 0%, 10%);
    border-top: 1px solid hsl(0, 0%, 90%);
    padding: 1rem;
    border-radius: 12px;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.1);
    margin: 1rem 0;
  }

  .content-form[data-media="ama"] h1 {
    color: hsl(0, 0%, 90%);
  }

  .content-form input,
  .content-form textarea {
    width: 100%;
    background-color: #222;
    border: 1px solid #555;
    color: #fff;
    padding: 0.5rem;
    border-radius: 8px;
    margin-bottom: 0.5rem;
  }

  .content-form[data-media] input,
  .content-form[data-media] textarea {
    width: 100%;
    background-color: #222;
    border: 1px solid #555;
    color: #f0f0f0;
    padding: 0.5rem;
    border-radius: 8px;
    margin-bottom: 0.5rem;
  }

  .content-form[data-media] label {
    display: block;
    margin: 0.5rem 0 0.2rem;
    color: #eee;
    font-weight: bold;
  }

  .content-form[data-media="ama"] button, a.btn {
    background-color: hsl(0,0%,20%);
    color: #f0f0f0;
    font-weight: bold;
    padding: 0.5rem 1rem;
    border: 1px solid #fff;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s ease;
    text-decoration: none;
  }

  .content-form[data-media="ama"] button:hover, a.btn:hover {
    background-color: hsl(0, 0%, 30%);
    text-decoration: none;
  }

</style>