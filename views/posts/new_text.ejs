<%- include('../partials/header') %>

<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet" href="/styles_typed_colors.css">


<% var isEdit = (mode === 'edit'); var P = post || {}; %>

<div class="center-form">
  <form action="<%= action %>" method="POST" enctype="multipart/form-data" class="content-form post-form" data-media="text">
    
    <input type="hidden" name="display_mode" value="<%= type %>">

    <h1><%= isEdit ? 'Edit text' : 'Text upload' %></h1>

    <label>Title:
      <input type="text" name="title" value="<%= P.title ? P.title : '' %>">
    </label>

    <label>Content*:
      <textarea name="content" rows="6" required><%= P.content ? P.content : '' %></textarea>
    </label>

    <button type="submit"><%= submitLabel %></button>
  
    <button type="button" class="btn" onclick="window.history.back()">CANCEL</button>
  </form>
</div>

<style>

.center-form {
  display: flex;
  justify-content: center;   /* centers horizontally */
  align-items: center;       /* centers vertically */
  /*height: 100vh;*/
}
  .content-form[data-media="text"] {
  background-color: hsl(240, 50%, 10%);
  border-top: 4px solid hsl(240, 90%, 50%);
  padding: 1rem;
  border-radius: 12px;
  box-shadow: 0 0 8px hsl(240, 90%, 20%);
  margin: 1rem 0;
  }

  .content-form[data-media="text"] h1 {
    color: #f0f0f0;
  }

  .content-form[data-media="text"] label {
    display: block;
    margin: 0.5rem 0 0.2rem;
    color: #eee;
    font-weight: bold;
  }

  .content-form[data-media="text"] input,
  .content-form[data-media="text"] textarea {
    width: 100%;
    background-color: #222;
    border: 1px solid #555;
    color: #f0f0f0;
    padding: 0.5rem;
    border-radius: 8px;
    margin-bottom: 0.5rem;
  }

  .content-form[data-media="text"] button,a.btn {
    background-color: hsl(240, 100%, 52%);
    color: #f0f0f0;
    font-weight: bold;
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s ease;
    text-decoration: none;
  }

  .content-form[data-media="text"] button:hover,a.btn:hover {
    background-color: hsl(240, 100%, 60%);
  }

  button:active {
    transform: scale(0.95);
  }

  form {
    width: 50%;
    padding: 1rem;
    border-radius: 12px;
  }
    
</style>

<script>
  // If user came from another page, send them back there instead of /posts
  (function () {
    var a = document.getElementById('cancelLink');
    if (document.referrer && new URL(document.referrer).origin === location.origin) {
      a.href = document.referrer;
    }
  })();
</script>