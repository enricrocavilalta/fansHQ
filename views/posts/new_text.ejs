<%- include('../partials/header') %>

<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet" href="/styles_typed_colors.css">


<% var isEdit = (mode === 'edit'); var P = post || {}; %>

<form action="<%= action %>" method="POST" enctype="multipart/form-data" class="content-form" data-media="text">
  <!-- for multipart forms, prefer query-string override -->
  <!-- OR also include this hidden input if you want -->
  <!-- <input type="hidden" name="_method" value="PUT"> -->

  <input type="hidden" name="display_mode" value="<%= type %>">

  <label>Title
    <input type="text" name="title" value="<%= P.title ? P.title : '' %>">
  </label>

  <label>Content
    <textarea name="content" rows="6" required><%= P.content ? P.content : '' %></textarea>
  </label>

  <button type="submit"><%= submitLabel %></button>
  <a id="cancelLink" href="/posts" class="btn btn-ghost">Cancel</a>
</form>


<style>
  .content-form[data-media="text"] {
  background-color: hsl(240, 50%, 10%);
  border-top: 4px solid hsl(240, 90%, 50%);
  padding: 1rem;
  border-radius: 12px;
  box-shadow: 0 0 8px hsl(240, 90%, 20%);
  margin: 1rem 0;
}

.content-form[data-media="text"] h1 {
  color: hsl(240, 90%, 50%);
}

.content-form[data-media="text"] label {
  display: block;
  margin: 0.5rem 0 0.2rem;
  color: #eee;
  font-weight: bold;
}

.content-form[data-media="text"] input,
.content-form[data-media="text"] textarea {
  width: 100%;
  background-color: #222;
  border: 1px solid #555;
  color: #fff;
  padding: 0.5rem;
  border-radius: 8px;
  margin-bottom: 0.5rem;
}

.content-form[data-media="text"] button {
  background-color: hsl(240, 90%, 50%);
  color: #fff;
  font-weight: bold;
  padding: 0.5rem 1rem;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: background-color 0.2s ease;
}

.content-form[data-media="text"] button:hover {
  background-color: hsl(240, 90%, 50%);
}

  form {
    width: 50%;
    margin: 1rem auto;
    margin: 1rem auto;  
    padding: 1rem;
    border-radius: 12px;
    }
    
</style>

<script>
  // If user came from another page, send them back there instead of /posts
  (function () {
    var a = document.getElementById('cancelLink');
    if (document.referrer && new URL(document.referrer).origin === location.origin) {
      a.href = document.referrer;
    }
  })();
</script>