<%- include('../partials/header') %>

<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet" href="/styles_typed_colors.css">

<%
  const P = (typeof post !== 'undefined' && post) ? post : {};
  const isEdit = !!P.id;
%>

<div class="center-form">
  <form action="<%= action %>" method="POST" enctype="multipart/form-data" class="content-form" data-media="tipjar">
    <input type="hidden" name="media_type" value="tipjar">
    
    
    <h1><%= isEdit ? 'Edit TipJar post' : 'TipJar upload' %></h1>
    
    <label>Title:</label>
    <input type="text" name="title"><br>

    <label>Description:</label>
    <textarea name="content"></textarea><br>

    <label>Suggested Tip:</label>
    <input type="number" name="price" step="0.01" min="0" value="1"><br>

    <label>Image:</label>
    <input type="file" name="media_file" accept="image/*"><br>
    
    <button type="submit">
      <%= isEdit ? 'UPDATE POST' : 'CREATE POST' %>
    </button>

    <button type="button" class="btn" onclick="window.history.back()">CANCEL</button>
  </form>
</div>

<style>
  .center-form {
    display: flex;
    justify-content: center;   /* centers horizontally */
    align-items: center;       /* centers vertically */
    /*height: 100vh;*/
  }

  .content-form[data-media] input,
  .content-form[data-media] textarea {
    width: 100%;
    background-color: #222;
    border: 1px solid #555;
    color: #fff;
    padding: 0.5rem;
    border-radius: 8px;
    margin-bottom: 0.5rem;
  }

  .content-form[data-media] label {
    display: block;
    margin: 0.5rem 0 0.2rem;
    color: #eee;
    font-weight: bold;
  }

  .content-form[data-media="tipjar"] button, a.btn {
    background-color: hsl(0,0%,20%) !important;
    color: #f0f0f0;
    font-weight: bold;
    padding: 0.5rem 1rem;
    border: 1px solid hsl(100,0%,50%);
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s ease;
    text-decoration: none;
  }

  .content-form[data-media="tipjar"] button:hover,a.btn:hover {
    background-color: #a0a0a0;
    color: #f0f0f0;
    text-decoration: none;
  }

  .content-form[data-media="tipjar"] {
    background-color: hsl(0, 0%, 5%);
    border-top: 1px solid hsl(0, 0%, 50%);
    box-shadow: 0 0 8px hsl(0, 0%, 20%);
    margin: 1rem 0;
    padding: 1rem;
    border-radius: 12px;
  }

  .content-form[data-media="tipjar"] h1 {
    color: #f0f0f0;
  }

  .content-form[data-media="tipjar"] button {
    background-color: hsl(0, 0%, 40%);
    color: #fff;
  }

  .content-form[data-media="tipjar"] button:hover, a.btn:hover {
    background-color: hsl(0, 0%, 30%) !important;
    text-decoration: none;
  }

    form {
    width: 50%;
    margin: 1rem auto;
    margin: 1rem auto;  
    padding: 1rem;
    border-radius: 12px;
    }
</style>