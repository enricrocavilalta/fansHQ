<%- include('../partials/header') %>

<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet" href="/styles_typed_colors.css">

<div class="center-form">
  <form action="<%= action %>" method="POST" enctype="multipart/form-data" class="content-form" data-media="poll">
    
    <input type="hidden" name="media_type" value="poll">
    
    <% const isEdit = (mode === 'edit'); %>
    <h1><%= isEdit ? 'Edit poll post' : 'Poll upload' %></h1>

    <label>Title:</label><br>
    <input type="text" name="title"><br><br>

    <label>Question*:</label><br>
    <textarea name="content" required></textarea><br><br>
    
    
  <% for (let i = 1; i <= 10; i++) { %>
    Option <%= i %><%= i <= 2 ? '*' : '' %>: <br>
    <input 
      type="text" 
      name="option_<%= i %>" 
      <%= i <= 2 ? 'required' : '' %>
    ><br><br>
  <% } %>

    <br>

    <button type="submit">
      <%= isEdit ? 'UPDATE POST' : 'CREATE POST' %>
    </button>

    <button type="button" class="btn" onclick="window.history.back()">CANCEL</button>
  </form>
</div>
<style>

.center-form {
  display: flex;
  justify-content: center;   /* centers horizontally */
  align-items: center;       /* centers vertically */
  /*height: 100vh;*/
}

.content-form[data-media="poll"] {
  background-color: hsl(270, 50%, 10%);
  border-top: 1px solid hsl(270, 100%, 52%);
  padding: 1rem;
  border-radius: 12px;
  box-shadow: 0 0 8px hsl(270, 50%, 10%);
  margin: 1rem 0;
}

.content-form[data-media="poll"] h1 {
  color: #f0f0f0;
}

.content-form[data-media] input,
.content-form[data-media] textarea {
  width: 100%;
  background-color: #222;
  border: 1px solid #555;
  color: #fff;
  padding: 0.5rem;
  border-radius: 8px;
  margin-bottom: 0.5rem;
}

.content-form[data-media] label {
  display: block;
  margin: 0.5rem 0 0.2rem;
  color: #eee;
  font-weight: bold;
}

.content-form[data-media="poll"] button, a.btn {
  background-color: hsl(270, 100%, 20%);
  color: #f0f0f0;
  font-weight: bold;
  padding: 0.5rem 1rem;
  border: 1px solid hsl(270,100%,50%);
  border-radius: 8px;
  cursor: pointer;
  transition: background-color 0.2s ease;
  text-decoration: none;
}

.content-form[data-media="poll"] button:hover, a.btn:hover {
  background-color: hsl(270, 90%, 30%);
  text-decoration: none;
}

  form {
    width: 50%;
    margin: 1rem auto;
    margin: 1rem auto;  
    padding: 1rem;
    border-radius: 12px;
    }
</style>
