<%- include('../partials/header') %>
<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet" href="/styles_typed_colors.css">

<div class="center-form">
  <form action="/posts" method="POST" enctype="multipart/form-data" class="content-form" data-media="audio">
  
    <input type="hidden" name="media_type" value="audio">
    <input type="hidden" name="display_mode" id="display_mode" value="upload">

    <% const isEdit = (mode === 'edit'); %>
    <h1><%= isEdit ? 'Edit audio post' : 'Audio upload' %></h1>


    <label>Choose how to add audio:</label>
    <div class="mode-selector">
      <div class="mode-box selected" data-mode="upload">
        <strong>Upload📤</strong><br>
        <input type="file" name="media_file" accept="audio/*">
      </div>
      <div class="mode-box" data-mode="embed">
        <strong>Embed🔗</strong><br>
        URL:<br> <input name="media_url" >
      </div>
    </div>

    <label>Thumbnail:</label><br>
    <input type="file" name="thumbnail" accept="image/*"><br><br>

    <label>Title:</label><br>
    <input type="text" name="title"><br><br>

    <label>Description:</label><br>
    <textarea name="content"></textarea><br><br>

    <button type="submit">Create</button>

    <a id="cancelLink" href="/posts" class="btn">Cancel</a>
  </form> 
</div>
<style>

  .center-form {
    display: flex;
    justify-content: center;   /* centers horizontally */
    align-items: center;       /* centers vertically */
    /*height: 100vh;*/
  }

  .mode-selector {
    display: flex;
    gap: 1rem;
    margin: 1rem 0;
  }

  .mode-box {
    background-color: #222; /* Gray background for unselected */
    border: 2px solid #aaa;
    border-radius: 10px;
    padding: 1rem;
    cursor: pointer;
    opacity: 0.6;
    text-align: center;
    transition: all 0.2s ease;
    color: #eee;
  }

  .mode-box.selected {
    border-color:hsl(120, 90%, 50%);
    opacity: 1;
    background-color: hsl(120, 50%, 10%);;
  }

  .mode-box input[type="file"],
  .mode-box textarea {
    margin-top: 0.5rem;
    width: 100%;
  }

  .content-form[data-media="audio"] {
    background-color: hsl(120, 50%, 10%);
    border-top: 4px solid hsl(120, 90%, 50%);
    padding: 1rem;
    border-radius: 12px;
    box-shadow: 0 0 8px rgba(0, 255, 0, 0.1);
    margin: 1rem 0;
  }

  .content-form[data-media="audio"] h1 {
    color: hsl(120, 90%, 50%);
  }

  .content-form[data-media] input,
  .content-form[data-media] textarea {
    width: 100%;
    background-color: #222;
    border: 1px solid #555;
    color: #fff;
    padding: 0.5rem;
    border-radius: 8px;
    margin-bottom: 0.5rem;
  }

  .content-form[data-media] label {
    display: block;
    margin: 0.5rem 0 0.2rem;
    color: #eee;
    font-weight: bold;
  }

  .content-form[data-media] button, a.btn {
    background-color: hsl(120, 90%, 25%);
    color:#f0f0f0;
    font-weight: bold;
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .content-form[data-media="text"] button:hover,a.btn:hover {
    background-color: hsl(120, 90%, 35%);
    text-decoration: none;
  }

  form {
    width: 50%;
    margin: 1rem auto;
    margin: 1rem auto;  
    padding: 1rem;
    border-radius: 12px;
  }

</style>

<script>
  const modeBoxes = document.querySelectorAll('.mode-box');
  const displayModeInput = document.getElementById('display_mode');

  modeBoxes.forEach(box => {
    box.addEventListener('click', () => {
      modeBoxes.forEach(b => b.classList.remove('selected'));
      box.classList.add('selected');
      displayModeInput.value = box.dataset.mode;
    });
  });
</script>
