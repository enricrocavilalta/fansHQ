        <button id="send-<%= post.id %>" style="background-color: #303030;color:#f0f0f0; border: none; border-radius: 6px;">Send</button>
      </div>

      <p id="err-<%= post.id %>" style="color:#b91c1c;display:none"></p>
      <ul id="list-<%= post.id %>"></ul>
    </section>

    <script>
    (function () {
      const pid   = <%= post.id %>;
      const box   = document.getElementById(`ama-${pid}`);
      if (!box || box.dataset.bound === "1") return;   // bind once per block
      box.dataset.bound = "1";

      const postId = box.dataset.postId;
      const qEl    = document.getElementById(`q-${pid}`);
      const email  = document.getElementById(`email-${pid}`);   // may be null if you remove email field
      const tip    = document.getElementById(`tip-${pid}`);     // now matches HTML
      const send   = document.getElementById(`send-${pid}`);
      const err    = document.getElementById(`err-${pid}`);
      const list   = document.getElementById(`list-${pid}`);

      let busy = false;

      function addRow(row) {
        const li = document.createElement("li");
        const meta = document.createElement("div");
        meta.style.opacity = ".7";
        meta.style.fontSize = ".8rem";
        meta.textContent = (row.email || "Anonymous") + " • " + new Date(row.created_at).toLocaleString();
        li.appendChild(meta);
        if (row.question) {
          const p = document.createElement("p");
          p.textContent = row.question;
          li.appendChild(p);
        }
        if (Number(row.tip) > 0) {
          const s = document.createElement("small");
          s.textContent = "Tip: €" + Number(row.tip).toFixed(2);
          li.appendChild(s);
        }
        list.insertBefore(li, list.firstChild);
      }

      send.addEventListener("click", async () => {
        if (busy) return;
        busy = true;
        err.style.display = "none";
        send.disabled = true;

        try {
          const payload = {
            question: qEl.value.trim() || null,
            email: email && email.value ? email.value.trim() : null,     // ✅ null-safe
            tip: tip && tip.value ? Number(tip.value) : 0                // ✅ null-safe
          };

          const res = await fetch(`/api/posts/${postId}/ask`, {
            method: "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify(payload)
          });
          if (!res.ok) throw new Error("Server error");

          const saved = await res.json();
          qEl.value = "";
          if (tip) tip.value = "";
        } catch (e) {
          err.textContent = "Couldn’t send. Try again.";
          err.style.display = "block";
        } finally {
          busy = false;
          send.disabled = false;
        }
      });
    })();
    </script>








