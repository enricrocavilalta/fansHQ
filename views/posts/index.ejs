        </div>
      </div>
  
      <style>
          /* only for poll posts */
        .post-card[data-media="poll"] input[type="checkbox"] {
          appearance: none;
          width: 1rem;
          height: 1rem;
          border: 2px solid #ccc;
          border-radius: 3px;
          display: inline-block;
          position: relative;
          cursor: pointer;
          transition: border-color .15s, background-color .15s;
        }

        /* hover effect */
        .post-card[data-media="poll"] input[type="checkbox"]:hover {
          border-color: hsl(270, 90%, 60%);
        }

        /* checked (purple fill + white tick) */
        .post-card[data-media="poll"] input[type="checkbox"]:checked {
          background-color: hsl(270, 90%, 50%);
          border-color: hsl(270, 90%, 50%);
        }

        /* draw the ✓ */
        .post-card[data-media="poll"] input[type="checkbox"]:checked::after {
          content: "";
          position: absolute;
          top: 2px;
          left: 6px;
          width: 4px;
          height: 8px;
          border: solid #f0f0f0;
          border-width: 0 2px 2px 0;
          transform: rotate(45deg);
        }

      </style>

      <script>
(() => {
  const form = document.getElementById('poll-<%= post.id %>');
  if (!form || form.dataset.bound === '1') return;
  form.dataset.bound = '1';

  // prevent any default submits (just in case)
  form.addEventListener('submit', e => e.preventDefault());

  const inputs = form.querySelectorAll('input[type="checkbox"][name="choices"]');
  const pid = form.dataset.pollId;
  const msg = form.querySelector('.msg');
  let t = null;
  let busy = false;

 async function send() {
  if (busy) return;
  busy = true;
  if (msg) msg.textContent = 'Saving…';

  const choices = Array.from(inputs)
    .filter(ch => ch.checked)
    .map(ch => Number(ch.value));

  try {
    const res = await fetch(`/api/polls/${pid}/vote`, {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json'
      },
      credentials: 'same-origin', // 👈 ensures cookies/session go with the request
      body: JSON.stringify({ choices })
    });

    if (!res.ok) throw new Error('server');
    const json = await res.json();

    const counts = {};
    (json.counts || []).forEach(r => counts[r.option_num] = r.votes);
    form.querySelectorAll('.count').forEach(span => {
      const opt = Number(span.dataset.option);
      span.textContent = counts[opt] != null ? counts[opt] : '';
    });

    if (msg) { msg.textContent = 'Saved'; setTimeout(() => msg.textContent = '', 800); }
  } catch (e) {
    if (msg) msg.textContent = 'Error';
    console.error(e);
  } finally {
    busy = false;
  }
}


  function schedule() {
    if (t) clearTimeout(t);
    t = setTimeout(send, 250); // debounce rapid toggles
  }

  inputs.forEach(ch => ch.addEventListener('change', schedule));
})();
      </script>
    
    <% } else if (post.media_type === 'product') { %>
