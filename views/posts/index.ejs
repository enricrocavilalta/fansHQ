        <form action="/posts/<%= post.id %>/tip" method="POST">
          <button type="submit" class="donate-btn">DONATE</button>
          <input type="number" name="tip" id="tip-<%= post.id %>" value="<%= post.price %>" step="1" min="1" size="3" required style="text-align:right;background-color:#303030;color:#f0f0f0;border:none;border-radius:6px;">$
        </form>
        
        <style>
          .donate-btn {
            display: inline-block;
            background-color: hsl(0,0%,20%);
            color: #f0f0f0;
            border: 1px solid  #808080;
            padding: 0.25rem 0.8rem;
