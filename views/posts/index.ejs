      <script>
(function () {
  const pid = <%= post.id %>;
  const box = document.getElementById(`ama-${pid}`);
  if (!box || box.dataset.bound === "1") return;
  box.dataset.bound = "1";

  // Scope everything to this AMA card
  const qEl  = box.querySelector(`#q-${pid}`);
  const email = box.querySelector(`#email-${pid}`); // may be null
  const tipEl = box.querySelector(`#tip-${pid}`);   // requires id="tip-<%= post.id %>"
  const send = box.querySelector(`#send-${pid}`);
  const err  = box.querySelector(`#err-${pid}`);
  const list = box.querySelector(`#list-${pid}`);
  const postId = box.dataset.postId;

  // Prevent accidental form submit
  if (send) send.type = 'button';

  let busy = false;

  function addRow(row) {
    const li = document.createElement("li");
    const meta = document.createElement("div");
    meta.style.opacity = ".7";
    meta.style.fontSize = ".8rem";
    meta.textContent = (row.email || "Anonymous") + " • " + new Date(row.created_at || Date.now()).toLocaleString();
    li.appendChild(meta);
    if (row.question) {
      const p = document.createElement("p");
      p.textContent = row.question;
      li.appendChild(p);
    }
    if (Number(row.tip) > 0) {
      const s = document.createElement("small");
      s.textContent = "Tip: €" + Number(row.tip).toFixed(2);
      li.appendChild(s);
    }
    list?.insertBefore(li, list.firstChild || null);
  }

  async function submit() {
    if (busy) return;
    busy = true;
    err.style.display = "none";
    send.disabled = true;

    const payload = {
      question: (qEl?.value || '').trim() || null,
      email: (email && email.value ? email.value.trim() : null),
      tip: tipEl && tipEl.value ? Number(tipEl.value) : 0
    };

    try {
      const res = await fetch(`/api/posts/${postId}/ask`, {
        method: "POST",
        headers: { "Content-Type": "application/json", "Accept": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify(payload)
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const saved = await res.json().catch(() => ({}));
      addRow(saved && (saved.row || saved) || payload);
      if (qEl) qEl.value = "";
      // if (tipEl) tipEl.value = ""; // keep tip if you prefer
    } catch (e) {
      console.error(e);
      err.textContent = "Couldn’t send. Try again.";
      err.style.display = "block";
    } finally {
      busy = false;
      send.disabled = false;
    }
  }

  send?.addEventListener("click", submit);
})();
      </script>
    <% } %>
<% }) %>     <!-- end posts.forEach -->
</div>
</section>
</div>
</div>

