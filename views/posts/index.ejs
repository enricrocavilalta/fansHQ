          <% } else { %>unknown<% } %>
          · <%= new Date(post.created_at).toLocaleDateString() %>
        </div>
      </div>
    <% } %>
<% }); %>

</section>

<script>
  const selector = document.getElementById('columnSelector');
  const grid = document.querySelector('.post-grid');

  selector.addEventListener('change', (e) => {
    grid.style.setProperty('--columns', e.target.value);
  });
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  // grab all author-info elements
  const metas = document.getElementsByClassName("author-info");

  // turn the HTMLCollection into a real array so we can loop safely
  Array.from(metas).forEach(meta => {
    // decide when to remove (example: empty or orphaned metas)
    if (!meta.nextElementSibling || meta.nextElementSibling.classList.contains("deleted")) {
      meta.remove();
    }
  });
});
</script>
