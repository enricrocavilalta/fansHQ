          }

          .donate-btn:hover {
            filter: brightness(1.2);
          }

          .donate-btn:active {
            transform: scale(0.95);
          }

        </style>

        <ul class="tipjar-list" id="tips-<%= post.id %>">
          <% (post.tips || []).sort((a,b) => {
            const tA = Number(a.tip||0);
            const tB = Number(b.tip||0);
            if (tA !== tB) return tB - tA;
            return a.id - b.id;
            }).forEach(t => { %>
            <li 
              data-id="<%= t.id %>"
              data-tip="<%= Number(t.tip) %>"
            >
              <b class="tip-amount"><%= Number(t.tip) %>€</b>
              <b class="donor"><%= ((t.username || 'Anonymous').split('@')[0]).toUpperCase() %></b>
            </li>
          <% }) %>
        </ul>

        <style>

          .tipjar-list {
            list-style: none;
            padding-left: 0;
            margin-top: .5rem;
          }

        </style>
        
        <script>
          function insertTipInOrder(ul, li, tipValue, id) {
            const children = Array.from(ul.children);

            for (let child of children) {
              const t = Number(child.dataset.tip);
              const i = Number(child.dataset.id);

              // Higher tip first
              if (tipValue > t) {
                ul.insertBefore(li, child);
                return;
              }

              // Same tip → older (smaller id) first
              if (tipValue === t && id < i) {
                ul.insertBefore(li, child);
                return;
              }
            }

            insertTipInOrder(ul, li, newTip.tip, newTip.id);

          }
        </script>


        <script>
        document.querySelectorAll('.tipjar-form').forEach(form => {
          form.addEventListener('submit', async e => {
            e.preventDefault();

            const postId = form.dataset.postId;
            const tipInput = form.querySelector('input[name="tip"]');
            const tip = Number(tipInput.value);

            const res = await fetch(`/posts/${postId}/tip`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ tip })
            });

            if (!res.ok) return;

            const newTip = await res.json(); 
            // { id, tip, username }

            const ul = document.getElementById(`tips-${postId}`);
            const li = document.createElement('li');

            const uname = ((newTip.username || 'Anonymous').split('@')[0]).toUpperCase();

            li.dataset.tip = newTip.tip;
            li.dataset.id  = newTip.id;
            
            li.innerHTML = `
              <b class="tip-amount">${newTip.tip}€</b>
              <b class="donor">${uname}</b>
            `;

            insertTipInOrder(ul, li, newTip.tip, newTip.id);

            tipInput.value = 1;
          });
        });
        </script>



        <div class="author-line">
          By
          <% if (post.email) { %>
          <a href="/posts/by/<%= post.email.split('@')[0] %>"><%= post.email.split('@')[0] %></a>
          <% } else { %>unknown<% } %>
          · <%= new Date(post.created_at).toLocaleDateString() %>
        </div>
      </div>

    <% } else if (post.media_type === 'ama') { %>
      <div class="post-card" data-media="<%= post.media_type %>">
        <div class="edit-delete">
          <form class="edit-form" action="/posts/<%= post.id %>/edit" method="GET">
            <button class="edit-btn">✎</button>
          </form>
          <form action="/posts/<%= post.id %>?_method=DELETE" method="POST">
            <button type="submit" class="delete-btn">&times;</button>
          </form>
        </div>

        <% if (post.title) { %><h2><%= post.title %></h2><% } %>
        <% if (post.content) { %><h3><%= post.content %></h3><br><% } %>

        <!-- AMA form -->
        <form class="ama-form" data-post-id="<%= post.id %>">
          <h5>Question:</h5>
          <input type="text" name="question" placeholder="Ask something..." required>
          <h5>Tip:</h5>
          <input type="number" name="tip" min="0" step="1" value="0"><br><br>
          <button type="submit" class="ask-btn">Ask</button>
        </form>

        <style>

          .ama-form input[type="text"],
          .ama-form input[type="number"] {
            background-color: #202020;
            color: #f0f0f0;
            border: none;
            padding: 0.4rem 0.6rem;
            border-radius: 6px;
            width: 100%;
            box-sizing: border-box;
          }

          .ama-form input[type="text"]::placeholder {
            color: #888;
          }

          .ama-form input[name="tip"] {
            width: 3%;               /* 3 characters wide */
            min-width: 3rem;        /* tiny but usable */
            background-color: #282828;
            color: #f0f0f0;
            border: none;
            padding: 0.3rem;
            border-radius: 6px;
            text-align: right;
          }

          .questions-list {
            list-style: none !important;
            padding-left: 0 !important;
            margin-left: 0 !important;
          }

          .tip-amount {
            color: gold;
            font-weight: 700;
          }

        </style>
        <% const ordered = [...post.questions].sort((a, b) => {
          const tipA = Number(a.tip || 0);
          const tipB = Number(b.tip || 0);
          if (tipA !== tipB) return tipB - tipA; // higher tip first
          return a.id - b.id;                    // older first
        }); %>

        <!--  questions INSIDE the post-card -->
        <ul class="questions-list" id="questions-<%= post.id %>">
          <% ordered.forEach(q => { %>
            <li
              data-id="<%= q.id %>"
              data-tip="<%= Number(q.tip || 0) %>"
            >
              <% if (q.tip && Number(q.tip) > 0) { %>
                <b style="color: gold;"><%= Number(q.tip) %>€</b>
              <% } %>
              <b class="uppercase"><%= q.username %>:</b> <%= q.question %>
            </li>
          <% }) %>
        </ul>

        

        <p id="err-<%= post.id %>" style="color:#b91c1c;display:none"></p>

        <div class="author-line">
          By
          <% if (post.email) { %>
          <a href="/posts/by/<%= post.email.split('@')[0] %>">
            <%= post.email.split('@')[0] %>
          </a>
          <% } else { %>unknown<% } %>
          · <%= new Date(post.created_at).toLocaleDateString() %>
        </div>
      </div>
    <% } %>

    <style>
            .ask-btn {
              display: inline-block;
              background-color: hsl(0,0%,20%);
              color: #f0f0f0 !important;
              padding: 0.25rem 0.8rem;
              border:1px solid #f0f0f0;
              border-radius: 50% / 100%;
              text-decoration: none;
              font-weight: 600;
              transition: filter .2s ease;
              font-size: 1rem;
            }

            .ask-btn:hover {
              filter: brightness(1.2);
            }

            .ask-btn:active {
              transform: scale(0.95);
            }

            .uppercase {
              text-transform: uppercase;
            }
    </style>
  

  
   <script>
  function insertQuestionInOrder(ul, li, tip, id) {
    const children = Array.from(ul.children);

    for (const child of children) {
      const t = Number(child.dataset.tip);
      const i = Number(child.dataset.id);

      // Higher tip first
      if (tip > t) {
        ul.insertBefore(li, child);
        return;
      }

      // Same tip → older (smaller id) first
      if (tip === t && id < i) {
        ul.insertBefore(li, child);
        return;
      }
    }

    // If we didn't return, it belongs at the end
    ul.appendChild(li);
  }

  document.querySelectorAll('.ama-form').forEach(form => {
    // 👇 EVITA MÚLTIPLES LISTENERS
    if (form.dataset.bound === "1") return;
    form.dataset.bound = "1";

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const postId = form.dataset.postId;
      const questionInput = form.querySelector('input[name="question"]');
      const tipInput = form.querySelector('input[name="tip"]');

      const question = questionInput.value.trim();
      const tip = parseFloat(tipInput.value || '0');

      if (!question) return;

      const res = await fetch(`/api/posts/${postId}/ask`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          question,
          tip        // 👈 el backend espera "tip"
        })
      });

      if (!res.ok) {
        console.error('Error sending AMA question');
        return;
      }

      const newQ = await res.json();
      // newQ: { id, post_id, username, question, tip }

      const ul = document.getElementById(`questions-${postId}`);
      if (!ul) return;

      const li = document.createElement('li');
      const tipValue = Number(newQ.tip || 0);
      li.dataset.tip = tipValue;
      li.dataset.id = newQ.id;

      let html = '';
      if (tipValue > 0) {
        html += `<b style="color:gold;">${tipValue}€</b> `;
      }
      html += `<b>${newQ.username.toUpperCase()}:</b> ${newQ.question}`;
      li.innerHTML = html;

      insertQuestionInOrder(ul, li, tipValue, newQ.id);

      // Clear form
      questionInput.value = '';
      tipInput.value = '0';
    });
  });
</script>


    <style>

        .ama-list {
          display: flex;
          flex-direction: column;
          gap: 10px;               /* small spacing between dolls */
        }

        .ama-entry {
          background: #202020;
          padding: 0px 12px;
          border-radius: 20px;
          color: #f0f0f0;
          font-size: 1rem;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
        }

        .questions ul {
          list-style: none;
          padding-left: 0;
          margin-left: 0;
        }

    </style>
   
  <% }) %>     <!-- end posts.forEach -->
</div>
</section>
