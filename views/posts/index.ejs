    <section id="ama-<%= post.id %>" data-post-id="<%= post.id %>">
      Question:<br>  
      <textarea id="q-<%= post.id %>" rows="3" placeholder="Ask anything…" style="background-color: #303030;color:#f0f0f0; border: none; border-radius: 6px;"></textarea><br><br>
      <div>
        Tip:<br>
