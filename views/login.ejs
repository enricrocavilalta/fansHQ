<%- include('partials/title') %>

<div class="auth-wrapper">

  <div class="auth-card">
    <h2 style="color:#f0f0f0;  text-align: center;">Sign Up</h2>
    <form method="POST" action="/signup" class="auth-form">
      <input type="email" name="email" placeholder="Email" required />
      <input type="password" name="password" placeholder="Password" required />
      <button type="submit" style="color:#f0f0f0;background-color:hsl(0,0%,20%);border: 1px solid #f0f0f0">Create account</button>
    </form>
  </div>

  <div class="auth-card">
    <h2 style="color:#f0f0f0;  text-align: center;">Login</h2>
    <form method="POST" action="/login" class="auth-form">
      <input type="email" name="email" placeholder="Email" required />
      <input type="password" name="password" placeholder="Password" required />
      <button type="submit" style="color:#f0f0f0;background-color:hsl(0,0%,20%);;border: 1px solid #f0f0f0">Log in</button>
    </form>
  </div>
  
</div>

<style>

  @import url('https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500;700&display=swap');

  html {
    font-family: 'Ubuntu', sans-serif !important;
  }

  html{
    background-color: #000;
  }
  

  form label {
    display: block;
    margin: 0.5rem 0 0.2rem;
    color: #eee;
    font-weight: bold;
  }

  form input:hover,
  form textarea:hover {
    filter: brightness(1.2);
  }

  form input,
  form textarea {
    width: 100%;
    background-color: #202020;
    border: 1px solid ;
    color: #fff;
    padding: 0.5rem;
    border-radius: 8px;
    margin-bottom: 0.5rem;
  }

  form button {
    background-color: #202020;
    color: #f0f0f0;
    font-weight: bold;
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  form button:hover {
    filter: brightness(1.2);
  }

  input:-webkit-autofill,
  input:-webkit-autofill:hover, 
  input:-webkit-autofill:focus {
    box-shadow: 0 0 0px 1000px #222 inset;
    -webkit-text-fill-color: #fff;
    transition: background-color 5000s ease-in-out 0s; /* removes flicker */
  }

  .auth-card {
    /*max-width: 400px;*/
    padding: 1.5rem;
    background: #101010;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.4);
  }

  /* make it look good on mobile too */
  .auth-card h1 {
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    margin-bottom: 1rem;
    text-align: center;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .auth-form label {
    font-size: 0.9rem;
    opacity: 0.9;
  }

  .auth-form input {
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    border: 1px solid #333;
    background: #181818;
    color: #f0f0f0;
  }

  .auth-form button {
    margin-top: 0.5rem;
    padding: 0.6rem;
    border-radius: 8px;
    border: none;
    background: #2d2d2d;
    color: #fff;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }



  .auth-form button:hover {
    filter: brightness(1.2);
  }

  .auth-form button:active {
    transform: scale(0.95);
  }



  


  .auth-wrapper {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 3rem;
  }

  .auth-card form {
    display: flex;
    flex-direction: column;
  }

  .auth-card input {
    background: #303030;
    border: none;
    padding: 0.5rem;
    color: #f0f0f0;
    border-radius: 6px;
    margin-bottom: 0.7rem;
  }

  .auth-card button {
    background: #f0f0f0;
    color: #000;
    padding: 0.5rem;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
  }

  .auth-card button:hover {
    filter: brightness(1.1);
  }


  @media (max-width: 700px) {
    .auth-wrapper {
      flex-direction: column;
      align-items: center;
    }
  }

</style>