<%- include('partials/header') %>

<div class="auth-card">
  <h2 style="color:#f0f0f0;  text-align: center;">Login</h2>
  <form method="POST" action="/login" class="auth-form">
    <input type="email" name="email" placeholder="Email" required /><br>
    <input type="password" name="password" placeholder="Password" required /><br>
    <button type="submit">Log in</button>
  </form>
</div>

<style>

  @import url('https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500;700&display=swap');

  html {
    font-family: 'Ubuntu', sans-serif !important;
  }

  html{
    background-color: #000;
  }
  form {
    width: 50%;
    margin: 1rem auto; 
    background-color: #101010;
    margin: 1rem auto;  
    padding: 1rem;
    border-radius: 12px;
  }

  form label {
    display: block;
    margin: 0.5rem 0 0.2rem;
    color: #eee;
    font-weight: bold;
  }

  form input:hover,
  form textarea:hover {
    width: 100%;
    background-color: #303030;
    border: 1px solid ;
    color: #fff;
    padding: 0.5rem;
    border-radius: 8px;
    margin-bottom: 0.5rem;
  }

  form input,
  form textarea {
    width: 100%;
    background-color: #202020;
    border: 1px solid ;
    color: #fff;
    padding: 0.5rem;
    border-radius: 8px;
    margin-bottom: 0.5rem;
  }

  form button {
    background-color: #202020;
    color: #fff;
    font-weight: bold;
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  form button:hover {
    background-color: #303030;
  }

  input:-webkit-autofill,
  input:-webkit-autofill:hover, 
  input:-webkit-autofill:focus {
    box-shadow: 0 0 0px 1000px #222 inset;
    -webkit-text-fill-color: #fff;
    transition: background-color 5000s ease-in-out 0s; /* removes flicker */
  }

  .auth-card {
    max-width: 400px;
    margin: 2rem auto;
    padding: 1.5rem;
    background: #101010;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.4);
  }

  /* make it look good on mobile too */
  .auth-card h1 {
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    margin-bottom: 1rem;
    text-align: center;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .auth-form label {
    font-size: 0.9rem;
    opacity: 0.9;
  }

  .auth-form input {
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    border: 1px solid #333;
    background: #181818;
    color: #f0f0f0;
  }

  .auth-form button {
    margin-top: 0.5rem;
    padding: 0.6rem;
    border-radius: 8px;
    border: none;
    background: #2d2d2d;
    color: #fff;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .auth-form button:hover {
    background: #3a3a3a;
  }

</style>