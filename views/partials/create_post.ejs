<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet" href="/styles_typed_colors.css">

<style>
  /* base: flex row with wrap */
  .create-a-post {
    display: flex;
    flex-wrap: wrap;      /* allow multiple lines */
    gap: 0.5rem;
    padding: 1rem;
    justify-content: center;
  }

  /* mobile: 2 per row */
  @media (max-width: 400px) {
    .create-a-post a {
      flex: 1 1 calc(50% - 0.5rem); /* 2 buttons per row */
      min-width: 120px;             /* keep them tappable */
    }
  }

  /* bigger screens: up to 10 across like before */
  @media (min-width: 401px) {
    .create-a-post a {
      flex: 1 1 calc(10% - 0.5rem); /* roughly a tenth each, with gaps */
      min-width: 90px;
    }
  }

  .create-a-post a {
   flex: 1;
   text-align: center;
   padding: 0.5rem;
   background-color: #2d2d2d;
   border-radius: 8px;
   text-decoration: none;
   transition: background-color 0.2s ease;
  }

 .create-a-post a:hover {
  filter: brightness(1.25); /* 25% brighter */
}

</style>

<div style="text-align:center;background-color:hsl(0,0%,10%);border-radius:10px;">
  <h2 style="text-align:center;color:#f0f0f0;">Create a post</h2>
  <div class="create-a-post">
    <a href="/posts/new/text" style="background-color:hsl(240,100%,10%);" data-media="text">Text</a>
    <a href="/posts/new/image" style="background-color:hsl(60,100%,10%);" data-media="image">Image</a>
    <a href="/posts/new/video" style="background-color:hsl(0,100%,10%);" data-media="video"> Video</a>
    <a href="/posts/new/audio" style="background-color:hsl(120,100%,10%);" data-media="audio">Audio</a>
    <a href="/posts/new/file" style="background-color:hsl(300,100%,10%);" data-media="file">File</a>
    <a href="/posts/new/link" style="background-color:hsl(180,100%,10%);" data-media="link">Link</a>
    <a href="/posts/new/product" style="background-color:hsl(30,100%,10%);" data-media="product">Product</a>
    <a href="/posts/new/poll" style="background-color:hsl(270,100%,10%);" data-media="poll">Poll</a>
    <a href="/posts/new/ama" style="background-color:hsl(0,0%,20%);" data-media="ama">AMA</a>
    <a href="/posts/new/tipjar" style="background-color:hsl(0,0%,20%);" data-media="tipjar">Tip Jar</a>
  </div>
</div>
