<head>
  <meta charset="UTF-8">
  <title>fansHQ</title>
  <link rel="icon" type="image/png" href="/HQgold.png">
  <link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500;700&display=swap" rel="stylesheet">
   <%- include('../partials/title', { pageTitle: 'Home · fansHQ' }) %>
</head>

<header>
  <nav style="text-align:right;">
    <!-- Optional UI control -->

    <% if (session && session.userId) { %>
      <a href="/logout" class="btn">Logout</a>
    <% } else { %>
      <a href="/login" class="btn-link">Login</a> |
      <a href="/signup" class="btn-link">Sign up</a>
    <% } %>
  </nav>
  <img src="/fansHQgoldpic.png" alt="" style="margin: 0 auto; display:block;">
  <script src="/ama.js" defer></script>
</header>

<style>
  /* ----- Login & link-style buttons ----- */
  .btn-link {
    display: inline-block;
    padding: 0.7rem 1.8rem;
    border-radius: 999px;
    color: #f0f0f0;
    background: #101010;
    font-family: 'Ubuntu', sans-serif;
    font-weight: 500;
    text-decoration: none;
    text-align: center;
    letter-spacing: 0.5px;
    transition: all 0.25s ease;
  }

    .btn-link:hover {
    display: inline-block;
    padding: 0.7rem 1.8rem;
    border-radius: 999px;
    color: #f0f0f0;
    background: #202020;
    font-family: 'Ubuntu', sans-serif;
    font-weight: 500;
    text-decoration: none;
    text-align: center;
    letter-spacing: 0.5px;
    transition: all 0.25s ease;
  }

</style>